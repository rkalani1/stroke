{
  "name": "stroke",
  "version": "7.7.3",
  "description": "Encounter workspace with embedded calculations, protocols, Pulsara summaries and Epic note templates.",
  "main": "service-worker.js",
  "scripts": {
    "validate:citations": "node ./scripts/validate-citations.mjs",
    "validate:pmids": "node ./scripts/validate-pmids.mjs",
    "validate:inline-citations": "node ./scripts/validate-inline-citations.mjs",
    "validate:inline-citations:strict": "node ./scripts/validate-inline-citations.mjs --strict",
    "validate:citations:links": "node ./scripts/validate-citations.mjs --check-links",
    "validate:citations:ids": "node ./scripts/validate-citations.mjs --check-identifiers",
    "validate:qa-latency-profiles": "node ./scripts/validate-qa-latency-profiles.mjs",
    "validate:automedbench-lite": "node ./scripts/validate-automedbench-lite.mjs",
    "evidence:validate": "node ./scripts/evidence-validate.mjs",
    "evidence:validate:json": "node ./scripts/evidence-validate.mjs --json",
    "content:validate": "node ./scripts/validate-content.mjs",
    "content:validate:json": "node ./scripts/validate-content.mjs --json",
    "content:currency": "node ./scripts/check-currency.mjs",
    "content:currency:strict": "node ./scripts/check-currency.mjs --strict",
    "analyze:sweep": "node ./scripts/parameter-sweep.mjs --domain all",
    "analyze:sweep:tnk": "node ./scripts/parameter-sweep.mjs --domain tnk",
    "analyze:sweep:large-core": "node ./scripts/parameter-sweep.mjs --domain large-core-evt",
    "analyze:sweep:dapt": "node ./scripts/parameter-sweep.mjs --domain dapt",
    "analyze:sweep:dawn": "node ./scripts/parameter-sweep.mjs --domain dawn",
    "qa:latency-adaptive-local": "node ./scripts/qa-smoke.mjs --local-only --latency-profile adaptive --latency-profiles-file docs/qa-latency-profiles.json --enforce-latency-thresholds",
    "qa:latency:recalibrate": "node ./scripts/qa-latency-recalibration.mjs",
    "qa:latency:suggest": "node ./scripts/qa-latency-threshold-suggest.mjs",
    "qa:wait-for-live-pages": "node ./scripts/wait-for-live-pages.mjs",
    "build:css": "tailwindcss -i ./src/styles.css -o ./tailwind.css --minify --postcss ./scripts/postcss.config.cjs",
    "build:js": "node ./scripts/build-browser.mjs",
    "build:compress": "node ./scripts/compress-assets.mjs",
    "agent:assets": "node ./scripts/generate-agent-assets.mjs",
    "agent:assets:check": "node ./scripts/generate-agent-assets.mjs --check",
    "build": "npm run agent:assets && npm run build:css && npm run build:js && npm run check:retirement && npm run publish:stage",
    "build:prod": "npm run build && npm run build:compress",
    "test:unit": "vitest run && npm run test:sw-controller",
    "test:sw-controller": "node --test tests/sw-controller.test.mjs",
    "test:mcp": "npm --prefix mcp run smoke",
    "test:protocol": "vitest run tests/protocol-currency-guards.test.js tests/public-demo-labels.test.js tests/no-institutional-identifiers.test.js tests/leak-guard.test.js tests/lighthouse-workflow.test.js tests/service-worker.test.js tests/navigation-reorganization.test.js",
    "test:protocol-snapshot": "node ./scripts/snapshot-example-protocols.mjs",
    "test:protocol-snapshot:update": "node ./scripts/snapshot-example-protocols.mjs --update",
    "test:unit:watch": "vitest",
    "lint:tokens": "node ./scripts/lint-tokens.mjs",
    "lint:touch-targets": "node ./scripts/lint-touch-targets.mjs",
    "lint:contrast": "node ./scripts/lint-contrast.mjs",
    "check:asset-budget": "node ./scripts/check-asset-budget.mjs",
    "check:asset-budget:json": "node ./scripts/check-asset-budget.mjs --json",
    "check:leak-guard": "git ls-files | node ./scripts/check-no-institutional-leak.mjs",
    "check:leak-guard:staged": "sh ./scripts/check-staged-leak-guard.sh",
    "hooks:install": "git config core.hooksPath .githooks",
    "check:clinical-claims": "node ./scripts/check-clinical-claims.mjs",
    "check:retirement": "node scripts/check-retirement.mjs",
    "publish:stage": "node scripts/publish-stage.mjs",
    "test": "npm run check:leak-guard && npm run check:asset-budget && npm run check:clinical-claims && npm run check:retirement && npm run test:protocol && npm run validate:citations && npm run validate:pmids && npm run validate:inline-citations && npm run evidence:validate && npm run content:validate && npm run validate:automedbench-lite && node scripts/qa-smoke.mjs --local-only",
    "qa": "npm test && node scripts/qa-smoke.mjs"
  },
  "keywords": [],
  "author": "",
  "license": "ISC",
  "private": true,
  "dependencies": {
    "@capacitor/android": "^8.3.1",
    "@capacitor/core": "^8.3.1",
    "@capacitor/ios": "^8.3.1",
    "react": "^18.3.1",
    "react-dom": "^18.3.1"
  },
  "devDependencies": {
    "@capacitor/cli": "^8.3.1",
    "esbuild": "^0.24.0",
    "playwright": "^1.57.0",
    "tailwindcss": "^3.4.10",
    "vitest": "^2.1.9"
  }
}
